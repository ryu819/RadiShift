# frozen_string_literal: true

source "https://rubygems.org"
git_source(:github) { |repo| "https://github.com/#{repo}.git" }

ruby "3.3.10"

gem "rails", "~> 8.1.2"

# ActiveRecord で MySQL を使う場合のアダプタ
gem "mysql2", "~> 0.5"

# Rails の標準 Web サーバー
gem "puma", ">= 5.0"

# Windowsではタイムゾーン情報がOSに含まれていないため、WindowsでRailsを動かす人向けに tzinfoのデータを別途インストールする
gem "tzinfo-data", platforms: %i[mingw mswin x64_mingw jruby]

# Rails の起動を高速化するキャッシュ機構（config/boot.rb で使用）
gem "bootsnap", require: false

# ユーザー認証を提供する
gem "devise"

# JWT認証を提供する
gem "devise-jwt"

# devise を日本語化する
gem "devise-i18n"

group :development, :test do
  # pry コンソールを使えるようにする。
  gem "pry-byebug"
  gem "pry-doc"
  gem "pry-rails"

  # テストフレームワーク rspec を導入する
  gem "rspec-rails"

  # rubocop を使えるようにする。
  gem "rubocop", require: false
  gem "rubocop-performance", require: false
  gem "rubocop-rails", require: false
  gem "rubocop-rspec", require: false

  # テストカバレッジ計測
  gem "simplecov", require: false
  gem "simplecov-console", require: false

  # N+1発生時にアラートを表示する
  gem "bullet"
end
