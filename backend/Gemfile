# frozen_string_literal: true

source "https://rubygems.org"
git_source(:github) { |repo| "https://github.com/#{repo}.git" }

ruby "3.3.13"

gem "rails", "~> 8.1.4"

# Active Storageバリデーション
gem "active_storage_validations"

# Active Storageの画像加工
gem "image_processing", "~> 1.2"

# 本番環境のActive StorageでAmazon S3を利用する
gem "aws-sdk-s3", require: false

# メッセージを日本語化
gem "rails-i18n"

# ActiveRecord で MySQL を使う場合のアダプタ
gem "mysql2", "~> 0.5"

# Rails の標準 Web サーバー
gem "puma", "~> 7.2.1"

# Windowsではタイムゾーン情報がOSに含まれていないため、WindowsでRailsを動かす人向けに tzinfoのデータを別途インストールする
gem "tzinfo-data", platforms: %i[mingw mswin x64_mingw jruby]

# Rails の起動を高速化するキャッシュ機構（config/boot.rb で使用）
gem "bootsnap", require: false

# ユーザー認証を提供する
gem "devise"

# JWT認証を提供する
gem "devise-jwt"

# devise を日本語化する
gem "devise-i18n"

# 祝日判定をする
gem "holiday_japan"

# Google ID Tokenの検証
gem "googleauth", "~> 1.17.4"

group :development, :test do
  # 開発環境でメール送信をテストする
  gem "letter_opener_web"

  # pry コンソールを使えるようにする。
  gem "pry-byebug"
  gem "pry-doc"
  gem "pry-rails"

  # テストフレームワーク rspec を導入する
  gem "rspec-rails"

  # テスト用データを作成する
  gem "factory_bot_rails"

  # rubocop を使えるようにする。
  gem "rubocop", require: false
  gem "rubocop-performance", require: false
  gem "rubocop-rails", require: false
  gem "rubocop-rspec", require: false

  # テストカバレッジ計測
  gem "simplecov", require: false
  gem "simplecov-console", require: false

  # N+1発生時にアラートを表示する
  gem "bullet"
end
